# Local / Docker development
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=sovereign_cloud
SECRET_KEY=replace_with_a_secure_secret

# Azure deployment settings
AZURE_STORAGE_USE_AZURE=false
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccount;AccountKey=yourkey;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=sovereign-cloud-files
AZURE_STORAGE_ACCOUNT_NAME=youraccount
AZURE_STORAGE_ACCOUNT_KEY=yourkey
DATABASE_URL=postgresql://postgres:yourpassword@your-server.postgres.database.azure.com:5432/sovereign_cloud
PORT=5000
FLASK_DEBUG=false
